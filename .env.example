# ============================================================================
# Evoluteam — variaveis de ambiente
# ============================================================================
# Ao deployar no Railway, garanta que TODAS as vars marcadas como
# [obrigatoria] estejam setadas no painel (Settings -> Variables).
# Diferenca entre dev e prod fica nos valores, nao na lista.
# ============================================================================

# Supabase [obrigatorias]
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend [obrigatoria] — emails transacionais (convites, notificacoes)
RESEND_API_KEY=

# E-mail que recebe leads do form da landing [obrigatoria em prod]
# Se ausente, cai no fallback "contato@evoluteam.com" (src/features/landing/actions.ts).
SALES_LEAD_RECIPIENT_EMAIL=

# URL publica da aplicacao [obrigatoria]
# Usada em emails (link de reset/convite) e metadata Open Graph.
# Em prod no Railway, setar para o dominio publico (ex: https://evolu.team).
NEXT_PUBLIC_SITE_URL=https://evolu.team

# ----------------------------------------------------------------------------
# Opcionais
# ----------------------------------------------------------------------------

# Liga logs de timing do getActorContext (src/features/auth/context.ts).
# Util para investigar lentidao em request. Manter desligado em prod.
# DEBUG_ACTOR=1

# ============================================================================
# Checklist Railway (antes do go-live):
# 1. Todas as vars [obrigatoria] acima setadas em Settings -> Variables.
# 2. Replicas = 1 (aba Settings -> Deploy). O cache em memoria de
#    src/lib/cache/memory.ts e por processo; >1 replica gera dados
#    de permissao stale por ate 30s entre instancias.
# 3. Build command: pnpm install --frozen-lockfile && pnpm build
# 4. Start command: pnpm start
# 5. Node version >= 20 (definido em package.json engines).
# ============================================================================
