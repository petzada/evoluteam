# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (obrigatorio para fluxo de convite — Fase 0)
RESEND_API_KEY=

# Sentry (DSN hardcoded nos configs; AUTH_TOKEN apenas para upload de source maps no build)
SENTRY_AUTH_TOKEN=

# Webhook de novo usuario (HMAC shared secret, mesmo valor em vault.webhook_secret do Supabase)
SUPABASE_WEBHOOK_SECRET=

# URL publica da aplicacao (usada em emails e metadata/OG)
NEXT_PUBLIC_SITE_URL=https://evolu.team
